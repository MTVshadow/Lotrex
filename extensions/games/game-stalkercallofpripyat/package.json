{
  "name": "game-stalkercallofpripyat",
  "version": "1.0.0",
  "description": "Support for S.T.A.L.K.E.R.: Call of Pripyat",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "copyfiles -u 1 -f ./src/*.js dist && pnpm run _assets && pnpm extractInfo"
  },
  "author": "Community",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "S.T.A.L.K.E.R.: Call of Pripyat"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
